ENV=dev

# Postgres database Credentials (for both airflow db and ecommerce source db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# DB connections for Airflow pipelines
AIRFLOW_CONN_ECOMMERCE_DB=postgresql://postgres:postgres@ecommerce_postgres:5432/ecommerce

# MinIO Credentials (S3 Lake)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000

# Airflow related
PYTHONDONTWRITEBYTECODE=1 # avoids writing .pyc and __pycache__ files
AIRFLOW__WEBSERVER__SECRET_KEY=secret_key_for_local_lakehouse_development_12345